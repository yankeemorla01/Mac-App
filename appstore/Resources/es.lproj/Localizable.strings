/* ===== Clear-history confirmation alert ===== */

/* Alert title. */
"alert.clear_history.title" = "¿Limpiar historial?";

/* Alert body. Format args, in order:
     %1$d — total captures on disk
     %2$d — captures from the last 30 days
     %3$d — captures older than 30 days
     %4$d — total copied-text items on disk
     %5$d — copied-text items from the last 30 days
     %6$d — copied-text items older than 30 days
   Keep the bullet character (•) and the line breaks. */
"alert.clear_history.body.format" = "Capturas guardadas: %1$d\n  • Últimos 30 días: %2$d\n  • Anteriores: %3$d\n\nTextos guardados: %4$d\n  • Últimos 30 días: %5$d\n  • Anteriores: %6$d\n\n¿Qué quieres borrar?";

/* Destructive primary button: deletes every saved capture. */
"alert.clear_history.button.delete_all" = "Borrar todo";

/* Secondary button: deletes only captures older than 30 days. */
"alert.clear_history.button.delete_old" = "Solo lo de más de 30 días";

/* Cancel button. */
"alert.clear_history.button.cancel" = "Cancelar";


/* ===== About alert ===== */

/* Title of the "About ClipShot" alert. Keep the brand name; the version
   number is part of the string and can stay as-is across languages. */
"about.title" = "ClipShot 2.1";

/* About-alert body. Format args, in order:
     %1$@ — full filesystem path of the user's screenshots folder
     %2$@ — full filesystem path of the saved-captures folder
   Keep the keyboard-shortcut text (Cmd+Shift+Ctrl+3/4 etc.) and the bullet
   character (•). Do not translate "Cmd", "Shift", "Ctrl" — those are the
   localized macOS modifier names that users recognize in any language. */
"about.body.format" = "Guarda automáticamente cada captura y, si lo activas, cada texto que copies. Mantiene un historial al que puedes volver con un solo clic.\n\nCómo capturar:\n  • Cmd+Shift+Ctrl+3/4 — directo al portapapeles\n  • Cmd+Shift+3/4 — guarda en %1$@\n  • Cmd+C — guarda el texto en el historial (si está activado en Preferencias)\n\nHistorial guardado en:\n  %2$@\n\n© 2026 Jean Carlos Morla Genao. Licencia MIT.\nEste software se distribuye \"tal cual\", sin garantías expresas o implícitas. El autor no se hace responsable de pérdida de datos o daños derivados del uso.";
