/* ===== Menu principal (menu déroulant de la barre d'état) ===== */

/* En-tête désactivé en haut du menu de la barre d'état. */
"menu.header.title" = "ClipShot — historique";

/* Ligne désactivée affichée quand l'historique est encore vide (aucune capture ni
