/* Élément de menu : ouvre dans le Finder le dossier où les captures sont conservées. */
"menu.action.open_history_folder" = "Ouvrir le dossier des captures";

/* Élément de menu : ouvre dans le Finder le dossier où les textes copiés sont conservés. */
"menu.action.open_text_folder" = "Ouvrir le dossier des textes";

/* Élément de menu : propose à l'utilisateur d'effacer l'historique enregistré. */
