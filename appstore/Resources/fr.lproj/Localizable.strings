/* ===== Alerte de confirmation : effacer l'historique ===== */

/* Titre de l'alerte. */
"alert.clear_history.title" = "Effacer l'historique ?";

/* Corps de l'alerte. Arguments de format, dans l'ordre :
     %1$d — total des captures sur le disque
     %2$d — captures des 30 derniers jours
     %3$d — captures de plus de 30 jours
   Conserver le caractère puce (•) et les sauts de ligne. */
"alert.clear_history.body.format" = "Captures enregistrées : %1$d\n  • 30 derniers jours : %2$d\n  • Plus anciennes : %3$d\n\nTextes enregistrés : %4$d\n  • 30 derniers jours : %5$d\n  • Plus anciens : %6$d\n\nQue veux-tu effacer ?";

/* Bouton principal destructif : supprime toutes les captures enregistrées. */
"alert.clear_history.button.delete_all" = "Tout effacer";

/* Bouton secondaire : supprime uniquement les captures de plus de 30 jours. */
"alert.clear_history.button.delete_old" = "Seulement plus de 30 jours";

/* Bouton Annuler. */
"alert.clear_history.button.cancel" = "Annuler";


/* ===== Alerte « À propos » ===== */

/* Titre de l'alerte « À propos de ClipShot ». Conserver le nom de marque ; le numéro
   de version fait partie de la chaîne et reste tel quel dans toutes les langues. */
"about.title" = "ClipShot 2.1";

/* Corps de l'alerte « À propos ». Arguments de format, dans l'ordre :
     %1$@ — chemin complet du dossier de captures de l'utilisateur
     %2$@ — chemin complet du dossier de l'historique enregistré
   Conserver les raccourcis clavier (Cmd+Shift+Ctrl+3/4 etc.) et le caractère puce (•).
   Ne pas traduire « Cmd », « Shift », « Ctrl » — ce sont les noms localisés des touches
   modificatrices macOS, reconnus dans toutes les langues. */
"about.body.format" = "Enregistre automatiquement chaque capture et, si tu l'actives, chaque texte que tu copies. Conserve un historique auquel tu peux revenir d'un seul clic.\n\nComment capturer :\n  • Cmd+Shift+Ctrl+3/4 — directement dans le presse-papiers\n  • Cmd+Shift+3/4 — enregistre dans %1$@\n  • Cmd+C — enregistre le texte dans l'historique (si activé dans les Préférences)\n\nHistorique enregistré dans :\n  %2$@\n\n© 2026 Jean Carlos Morla Genao. Licence MIT.\nCe logiciel est distribué « tel quel », sans garantie expresse ou implicite. L'auteur n'est pas responsable des pertes de données ou dommages liés à son utilisation.";
