<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>ClipShot</string>
    <key>CFBundleDisplayName</key>
    <string>ClipShot</string>
    <key>CFBundleIdentifier</key>
    <string>com.josecasadogenao.clipshot</string>
    <key>CFBundleVersion</key>
    <string>1.7</string>
    <key>CFBundleShortVersionString</key>
    <string>1.7</string>
    <!-- Idioma base (inglés) + idiomas disponibles. macOS elige es.lproj si el
         Mac está en español; en cualquier otro caso usa el inglés base. -->
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>es</string>
    </array>
    <key>CFBundleExecutable</key>
    <string>ClipShot</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Jean Carlos Morla Genao. All rights reserved.</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSDesktopFolderUsageDescription</key>
    <string>ClipShot needs access to your Desktop to detect new screenshots.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>ClipShot needs access to Downloads to detect screenshots saved there.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>ClipShot needs access to Documents to detect screenshots saved there.</string>
    <key>NSPicturesFolderUsageDescription</key>
    <string>ClipShot needs access to Pictures to detect screenshots saved there.</string>

    <!-- Sparkle auto-update. The feed lives on GitHub Pages; if the URL is moved, update here. -->
    <key>SUFeedURL</key>
    <string>https://josegcasadogenao.github.io/clipshot/appcast.xml</string>
    <!-- EdDSA public key matching the private key in the local keychain (sparkle_ed_secret). -->
    <key>SUPublicEDKey</key>
    <string>WEbBbBRnUX8PXRUzhk2OHG4JDbEJRJAfO539CPmTA7k=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <!-- 86400 seconds = once per day. -->
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
</dict>
</plist>
